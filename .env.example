# Copy to .env and fill in. Never commit the real file.
#
#   cp .env.example .env

# ---------------------------------------------------------------- database
# Supabase → Project Settings → Database → Connection string → URI.
# Use the POOLER on port 6543 (transaction mode): it is what a Node app
# behind a proxy should use, and the app disables prepared statements to suit
# it. Remember to URL-encode any special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional. Connections held open by this app; the pooler does the rest.
# DATABASE_POOL_MAX=5

# ------------------------------------------------------------------- admin
# Sign-in for /admin.
# Generate the hash with:  npm run hash-password -- "your password"
# The plain password is never stored, so keep your own copy of it.
ADMIN_USERNAME=pazuri
ADMIN_PASSWORD_HASH=generate-with-npm-run-hash-password

# ------------------------------------------------------------- the site url
# Required in production, or SvelteKit's CSRF check rejects every form POST
# with 403. docker-compose passes this through as ORIGIN.
PUBLIC_SITE_URL=https://kilimanjaropazurivilla.com

# ------------------------------------------------------------------- email
# Alerts for new bookings, and the guest's acknowledgement and confirmation.
# Optional: with no key the site runs exactly as before and simply logs the
# messages it would have sent. A booking is never lost to a mail failure.
#
# Resend → API Keys. The `from` address must be on a domain verified in that
# Resend account, or the send is rejected.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=Kilimanjaro Pazuri <bookings@kilimanjaropazurivilla.com>
#
# Where new-booking alerts go. Defaults to the address in the site content.
# MAIL_TO=Kilimanjaropazurivillas@gmail.com
