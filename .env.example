# Copy to .env on the server and fill in. Never commit the real file.

# Where the SQLite database lives. In Docker this is the mounted volume.
DATABASE_PATH=/data/kilimanjaro-pazuri.db

# Admin sign-in for /admin.
# Generate the hash with:  npm run hash-password -- "your password"
ADMIN_USERNAME=pazuri
ADMIN_PASSWORD_HASH=generate-with-npm-run-hash-password

# Required in production, or SvelteKit rejects every form POST with 403.
ORIGIN=https://pazuri.makutano.co.tz

# So the enquiry rate limiter sees the visitor, not the reverse proxy.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
