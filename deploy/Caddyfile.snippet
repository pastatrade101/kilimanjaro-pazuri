# Append to ~/app/config/Caddyfile on the server, then:
#   docker exec makutano-digital-caddy caddy reload --config /etc/caddy/Caddyfile
# Caddy obtains and renews the certificate for this name automatically.

pazuri.makutano.co.tz {
    # adapter-node only pre-compresses the files it built, so server-rendered
    # pages and API payloads would otherwise go out raw.
    encode zstd gzip
    reverse_proxy kilimanjaro-pazuri:3000
}
