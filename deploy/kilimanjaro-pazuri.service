# Alternative to Docker: systemd running the adapter-node build directly.
#   sudo cp deploy/kilimanjaro-pazuri.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now kilimanjaro-pazuri

[Unit]
Description=Kilimanjaro Pazuri website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/srv/kilimanjaro-pazuri
EnvironmentFile=/srv/kilimanjaro-pazuri/.env
Environment=NODE_ENV=production
Environment=PORT=3021
Environment=ORIGIN=https://pazuri.makutano.co.tz
Environment=ADDRESS_HEADER=X-Forwarded-For
Environment=XFF_DEPTH=1
Environment=DATABASE_PATH=/srv/kilimanjaro-pazuri/data/kilimanjaro-pazuri.db
ExecStart=/usr/bin/node build
Restart=on-failure
RestartSec=5

# The app only ever writes to its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kilimanjaro-pazuri/data

[Install]
WantedBy=multi-user.target
